.rainbow-album{:class=> rainbow_css(album), :id=> album.rainbow_table.to_s+'_link'}
  .rainbow-album-container
    %img.cover{:src=> album.cover.to_s, :alt=> album.title}
    %h3.year
      = just_the_year(album)
    %h4.title
      = album.title
    - if album.album_streaming_links.length > 0
      .rainbow-table-streaming-links
        = render partial: "album_streaming_links/album_streaming_link", collection: order_streaming_links_by_service_name(album)
    %p.description
      = album.description.html_safe
    - if album.songs.any?
      = turbo_frame_tag dom_id(album, :songs), class: "songs" do
        = render "songs/list", album: album, songs: album.songs
